[data]
NAME         = hypmol
GET_DATA_CMD = cat hypmol/ontology.ttl hypmol/synthetic_graph.ttl
DESCRIPTION  = "HypMol Synthetic Chemistry Graph"

[index]
INPUT_FILES     = hypmol/ontology.ttl hypmol/synthetic_graph.ttl
CAT_INPUT_FILES = cat ${INPUT_FILES}

[server]
PORT         = 7001
ACCESS_TOKEN = hypmol-secret

[runtime]
SYSTEM = docker
IMAGE  = docker.io/adfreiburg/qlever:latest

[ui]
UI_PORT   = 7002
UI_CONFIG = default
