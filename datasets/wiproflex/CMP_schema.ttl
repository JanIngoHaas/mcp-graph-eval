RO:0001025 a owl:ObjectProperty ; # "located in"
    rdfs:label "located in"@en ;
    rdfs:domain cmpo:Consumable ;
    rdfs:range cmpo:Tool .

RO:0000051 a owl:ObjectProperty ; # "has part"
    rdfs:label "has part"@en ;
    rdfs:domain cmpo:Tool ;
    rdfs:range cmpo:Software .

cmpo:hasPad a owl:ObjectProperty ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000051 ; # has part
    rdfs:domain cmpo:Conditioner ;
    rdfs:range cmpo:Pad .

cmpo:hasStep a owl:ObjectProperty ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000051 ; # has part
    rdfs:domain cmpo:OxideCMPProcess ;
    rdfs:range cmpo:Step .

cmpo:hasRingLifetime a owl:ObjectProperty ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000086 ; # has part
    rdfs:domain cmpo:RetainingRing ;
    rdfs:range cmpo:RetainingRingLifetime .

cmpo:hasPadLifetime a owl:ObjectProperty ;
    rdfs:comment "Relates a Pad to its lifetime quality (e.g., number of polishing cycles before replacement)."@en  ;
    rdfs:subPropertyOf RO:0000086   ;      # has part quality
    #rdfs:label "has pad lifetime"@en ; # Question: usable for polishingpad and conditioning pad?
    rdfs:domain cmpo:Pad    ;
    rdfs:range cmpo:PadLifetime .

cmpo:hasChargeNo a owl:ObjectProperty ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000086 ; # has part
    rdfs:domain cmpo:Slurry ;
    rdfs:range cmpo:SlurryChargeNo .

RO:0000054 a owl:ObjectProperty ; # "has part"
    rdfs:label "realized in"@en ;
    rdfs:comment "The recipe is realized in a collection of Parameters for components and consumables" ;
    rdfs:domain cmpo:Recipe ;
    rdfs:range cmpo:Parameter .

RO:0000085 a owl:ObjectProperty ; # "has function"
    rdfs:label "has function"@en ;
    rdfs:comment "" .

cmpo:processes a owl:ObjectProperty ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000085 ; # has function
    rdfs:domain cmpo:Tool ;
    rdfs:range cmpo:Wafer .

cmpo:uses a owl:ObjectProperty ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000085 ; # has function
    rdfs:domain cmpo:Tool ;
    rdfs:range cmpo:Recipe .

cmpo:holds a owl:ObjectProperty ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000085 ; # has function
    rdfs:domain cmpo:WaferHead, cmpo:RetainingRing ;
    rdfs:range cmpo:Wafer .

cmpo:documents a owl:ObjectProperty ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000085 ; # has function
    rdfs:domain cmpo:DataSource ;
    rdfs:range cmpo:Parameter .

cmpo:runs a owl:ObjectProperty ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000085 ; # has function
    rdfs:domain cmpo:ToolExpert, cmpo:ProcessExpert ;
    rdfs:range cmpo:CMPProcess .


RO:0000087 a owl:ObjectProperty ; # "has part"
    rdfs:label "has role" ;
    rdfs:comment "The recipe is realized in a collection of  Parameters" ;
    rdfs:domain cmpo:Recipe ;
    rdfs:range cmpo:Parameter .

cmpo:influences a owl:ObjectProperty ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000087 ; # has part
    rdfs:domain cmpo:WaferMaterialToRemove ;
    rdfs:range cmpo:Recipe .

#cmpo:documentedIn a owl:ObjectProperty ;
    #rdfs:comment "" ;
   # rdfs:subPropertyOf RO:0001025 ; # has part
