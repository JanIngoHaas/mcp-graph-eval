    rdfs:comment "Material composition."@en .

cmpo:ringStatus a owl:DatatypeProperty ;
    rdfs:label "ring status"@en ;
    rdfs:domain cmpo:RetainingRing ;
    rdfs:range xsd:string ;
    rdfs:comment "Current quality status."@en .

cmpo:diskType a owl:DatatypeProperty ;
    rdfs:label "disk type"@en ;
    rdfs:domain cmpo:ConditionerPad ;
    rdfs:range xsd:string ;
    rdfs:comment "Abrasive type."@en .

cmpo:gritSize a owl:DatatypeProperty ;
    rdfs:label "grit size"@en ;
    rdfs:domain cmpo:ConditionerPad ;
    rdfs:range xsd:integer ;
