cmpo:usesToolBreakInRecipe a owl:ObjectProperty ;
    rdfs:label "uses tool break-in recipe"@en ;
    rdfs:domain cmpo:ToolBreakIn ;
    rdfs:range cmpo:ToolBreakInRecipe .

cmpo:usesCleaningRecipe a owl:ObjectProperty ;
    rdfs:domain cmpo:Cleaning ; #Cleaner (Class name)
    rdfs:range cmpo:CleaningRecipe .

