cmpo:hasPadLifetime a owl:ObjectProperty ;
    rdfs:label "has pad lifetime"@en ;
    rdfs:comment "Relates a Pad to its lifetime quality (e.g., number of polishing cycles before replacement)."@en  ;
    rdfs:subPropertyOf RO:0000086   ;      # has part quality
    rdfs:domain cmpo:Pad    ;
    rdfs:range cmpo:PadLifetime .

cmpo:hasChargeNo a owl:ObjectProperty ;
    rdfs:label "has charge number"@en ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000086 ; # has part
    rdfs:domain cmpo:Slurry ;
    rdfs:range cmpo:SlurryChargeNo .

RO:0000054 a owl:ObjectProperty ; # "has part"
    rdfs:label "realized in"@en ;
    rdfs:comment "The recipe is realized in a collection of Parameters for components and consumables" ;
    rdfs:domain cmpo:Recipe ;
    rdfs:range cmpo:Parameter .

RO:0000085 a owl:ObjectProperty ; # "has function"
    rdfs:label "has function"@en ;
    rdfs:comment "" .

cmpo:processes a owl:ObjectProperty ;
    rdfs:label "processes"@en ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000085 ; # has function
    rdfs:domain cmpo:Tool ;
    rdfs:range cmpo:Wafer .

cmpo:uses a owl:ObjectProperty ;
    rdfs:label "uses"@en ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000085 ; # has function
    rdfs:domain cmpo:Tool ;
    rdfs:range cmpo:Recipe .

cmpo:holds a owl:ObjectProperty ;
    rdfs:label "holds"@en ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000085 ; # has function
    rdfs:domain cmpo:WaferHead, cmpo:RetainingRing ;
    rdfs:range cmpo:Wafer .

cmpo:documents a owl:ObjectProperty ;
    rdfs:label "documents"@en ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000085 ; # has function
    rdfs:domain cmpo:DataSource ;
    rdfs:range cmpo:Parameter .

cmpo:runs a owl:ObjectProperty ;
    rdfs:label "runs"@en ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000085 ; # has function
    rdfs:domain cmpo:ToolExpert, cmpo:ProcessExpert ;
    rdfs:range cmpo:CMPProcess .

RO:0000087 a owl:ObjectProperty ; # "has part"
    rdfs:label "has role" ;
    rdfs:comment "The recipe is realized in a collection of  Parameters" ;
    rdfs:domain cmpo:Recipe ;
    rdfs:range cmpo:Parameter .

cmpo:influences a owl:ObjectProperty ;
    rdfs:label "influences"@en ;
    rdfs:comment "" ;
    rdfs:subPropertyOf RO:0000087 ; # has part
    rdfs:domain cmpo:WaferMaterialToRemove ;
    rdfs:range cmpo:Recipe .

#cmpo:documentedIn a owl:ObjectProperty ;
    #rdfs:comment "" ;
    # rdfs:subPropertyOf RO:0001025 ; # has part
    #rdfs:domain cmpo:WaferDefects ;
    # rdfs:range cmpo:ProcessCard .

#################################################################
### Data Properties
#################################################################

cmpo:UniformityPercentValue rdf:type owl:DatatypeProperty ;
    rdfs:label "uniformity percent value"@en ;
    rdfs:domain cmpo:Uniformity ;
    rdfs:comment "Value given in percent." ;
    rdfs:range xsd:float .

cmpo:thicknessValue rdf:type owl:DatatypeProperty ;
    rdfs:label "thickness value"@en ;
    rdfs:domain cmpo:WaferThickness ;
    rdfs:comment "Value given in nanometer." ;
    rdfs:range xsd:float .

cmpo:diameterValue rdf:type owl:DatatypeProperty ;
    rdfs:label "diameter value"@en ;
    rdfs:domain cmpo:WaferDiameter ;
    rdfs:comment "Value given in milimeter or inch." ;
    rdfs:range xsd:float .

cmpo:machineID rdf:type owl:DatatypeProperty ;
    rdfs:label "machine ID"@en ;
    rdfs:domain cmpo:Tool ;
    rdfs:comment "ID of the machine" ;
    rdfs:range xsd:string .

cmpo:platenSpeed rdf:type owl:DatatypeProperty ;
    rdfs:label "platen speed"@en ;
    rdfs:domain cmpo:Platen ;
    rdfs:comment "speed of platen" ;
    rdfs:range xsd:float .

cmpo:lifetime rdf:type owl:DatatypeProperty ;
    rdfs:label "lifetime"@en ;
    rdfs:domain cmpo:RetainingRing ;
    rdfs:comment "lifetime of the retaining ring" ;
    rdfs:range xsd:float .

cmpo:hasNumericValue rdf:type owl:DatatypeProperty ;
    rdfs:label "has numeric value"@en ;
    rdfs:domain cmpo:Parameter ;
    rdfs:range xsd:float .

cmpo:hasUnit rdf:type owl:DatatypeProperty ;
    rdfs:label "has unit"@en ;
    rdfs:domain cmpo:Parameter ;
    rdfs:range xsd:string .

cmpo:hasMachineData rdf:type owl:DatatypeProperty ;
    rdfs:label "has machine data"@en ;
    rdfs:domain cmpo:CMPProcess ;
    rdfs:range xsd:string .

cmpo:hasTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:label "has timestamp"@en ;
    rdfs:domain cmpo:CMPProcess ;
    rdfs:range xsd:dateTime .

#################################################################
### Schema-Level Assertions (Connections)
#################################################################

### CMPProcess uses  parameters
#cmpo:CMPProcess rdfs:subClassOf [
    #  a owl:Restriction ;
    #  owl:onProperty cmpo:hasParameter ;
    #  owl:someValuesFrom cmpo:Pressure
#] .
# cmpo:CMPProcess cmpo:hasParameter cmpo:Temperature .
# cmpo:CMPProcess cmpo:hasParameter cmpo:Velocity .
# cmpo:CMPProcess cmpo:hasParameter cmpo:Time .
# cmpo:CMPProcess cmpo:hasParameter cmpo:Conditioning .
# cmpo:CMPProcess cmpo:hasParameter cmpo:SlurryType .

# ### CMPProcess uses sub-parameters explicitly
# cmpo:CMPProcess cmpo:hasParameter cmpo:HeadSpeed .
# cmpo:CMPProcess cmpo:hasParameter cmpo:PlatenSpeed .
# cmpo:CMPProcess cmpo:hasParameter cmpo:RetainingRingPressure .
# cmpo:CMPProcess cmpo:hasParameter cmpo:DownPressure .
# cmpo:CMPProcess cmpo:hasParameter cmpo:InnerTubePressure .
# cmpo:CMPProcess cmpo:hasParameter cmpo:ProcessTime .
# cmpo:CMPProcess cmpo:hasParameter cmpo:PolishingTime .
# cmpo:CMPProcess cmpo:hasParameter cmpo:SweepsToBreakIn .
# cmpo:CMPProcess cmpo:hasParameter cmpo:SweepsDuringProcess .

# ### CMPProcess produces  parameters
# cmpo:CMPProcess cmpo:hasParameter cmpo:MRR .
# cmpo:CMPProcess cmpo:hasParameter cmpo:Roughness .
# cmpo:CMPProcess cmpo:hasParameter cmpo:LayerThickness .

# ### CMPProcess acts on wafer
# cmpo:CMPProcess cmpo:actsOn cmpo:Wafer .

# ### Wafer has properties
# cmpo:Wafer cmpo:hasProperty cmpo:WaferDiameter .

# ### CMPProcess consumes consumables
# cmpo:CMPProcess cmpo:consumesMaterial cmpo:Slurry .
# cmpo:CMPProcess cmpo:consumesMaterial cmpo:SlurryCharge .

# ### CMPProcess uses equipment
# cmpo:CMPProcess cmpo:usesEquipment cmpo:CMPTool .
# cmpo:CMPProcess cmpo:usesEquipment cmpo:OxideCMPTool .
# cmpo:CMPProcess cmpo:usesEquipment cmpo:Platen .
# cmpo:CMPProcess cmpo:usesEquipment cmpo:RetainingRing .
# cmpo:CMPProcess cmpo:usesEquipment cmpo:Pad .
# cmpo:CMPProcess cmpo:usesEquipment cmpo:PadConditioner .
# cmpo:CMPProcess cmpo:usesEquipment cmpo:SlurryDeliveryPipe .
# cmpo:CMPProcess cmpo:usesEquipment cmpo:CleanerDryer .
# cmpo:CMPProcess cmpo:usesEquipment cmpo:MeasurementTool .

# ### CMPProcess performed by agents
# cmpo:CMPProcess cmpo:performedBy cmpo:ProcessEngineer .
# cmpo:CMPProcess cmpo:performedBy cmpo:Student .
# cmpo:CMPProcess cmpo:performedBy cmpo:Worker .

# ### Agents have roles
# cmpo:ProcessEngineer cmpo:hasRole cmpo:EngineerRole .
# cmpo:Worker cmpo:hasRole cmpo:WorkerRole .

# ### Equipment has dispositions
# cmpo:Pad cmpo:hasDisposition cmpo:PadLifetime .
# cmpo:Slurry cmpo:hasDisposition cmpo:SlurryChargeLife .
# cmpo:RetainingRing cmpo:hasDisposition cmpo:RetainingRingLife .

# ### CMPProcess occurs in phases
# cmpo:CMPProcess cmpo:occursInPhase cmpo:LoadingPhase .
# cmpo:CMPProcess cmpo:occursInPhase cmpo:ToolBreakIn .
# cmpo:CMPProcess cmpo:occursInPhase cmpo:PolishingPhase .
# cmpo:CMPProcess cmpo:occursInPhase cmpo:OverPolishing .
# cmpo:CMPProcess cmpo:occursInPhase cmpo:CleaningPhase .
# cmpo:CMPProcess cmpo:occursInPhase cmpo:DryingPhase .
# cmpo:CMPProcess cmpo:occursInPhase cmpo:UnloadingPhase .
# cmpo:CMPProcess cmpo:occursInPhase cmpo:PreMeasurement .
# cmpo:CMPProcess cmpo:occursInPhase cmpo:PostMeasurement .