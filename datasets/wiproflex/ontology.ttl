@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix cmpo: <https://tucid/cpmo/> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
# @prefix redfs: <> .  # FIX: Removed empty prefix - was causing parse errors
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
### Ontology Header
#################################################################

<https://tucid/cpmo/schema> rdf:type owl:Ontology ;
    rdfs:label "CMP Schema-Level Ontology"@en ;
    rdfs:comment "CMP Schema-Level Ontology aligned with BFO (TBox + schema connections)" .

#################################################################
### Core Classes (BFO Anchors)
#################################################################

cmpo:Equipment       rdfs:subClassOf BFO:0000030 ; # BFO:object
    rdfs:label "Equipment"@en .
cmpo:Lot             rdfs:subClassOf BFO:0000030 ;
    rdfs:label "Lot"@en .
cmpo:Wafer           rdfs:subClassOf BFO:0000030 ;
    rdfs:label "Wafer"@en .
cmpo:Agent           rdfs:subClassOf BFO:0000030 ; # yes. agent = object (has role)
    rdfs:label "Agent"@en .
cmpo:CMPProcess      rdfs:subClassOf BFO:0000015 ; # BFO:process
    rdfs:label "CMP Process"@en .
cmpo:Measurement       rdfs:subClassOf BFO:0000015 ; # BFO:process
    rdfs:label "Measurement"@en .
# cmpo:Step        rdfs:subClassOf BFO:0000011 ;
#    rdfs:label "Step"@en . 
cmpo:Parameter       rdfs:subClassOf BFO:0000019 ;
    rdfs:label "Parameter"@en .

    cmpo:Parameter    rdfs:subClassOf iao:0000030 .

cmpo:Layout          rdfs:subClassOf BFO:0000019 ;
    rdfs:label "Layout"@en .
    # BFO:quality
#cmpo:Role            rdfs:subClassOf BFO:Role .
#cmpo:Disposition     rdfs:subClassOf BFO:Disposition .

#################################################################
### Equipment Hierarchy
#################################################################

cmpo:Tool            rdfs:subClassOf cmpo:Equipment ;
    rdfs:label "Tool"@en .
cmpo:CMPTool         rdfs:subClassOf cmpo:Tool ;
    rdfs:label "CMP Tool"@en .
cmpo:OxideCMPTool    rdfs:subClassOf cmpo:CMPTool ;
    rdfs:label "Oxide CMP Tool"@en .
cmpo:IPEC            rdfs:subClassOf cmpo:OxideCMPTool ; #Instance
    rdfs:label "IPEC"@en .
cmpo:MIRRA           rdfs:subClassOf cmpo:OxideCMPTool ; #Instance
    rdfs:label "MIRRA"@en .
cmpo:Layout          rdfs:subClassOf BFO:0000019 .
cmpo:Software        rdfs:subClassOf BFO:0000141 ;
    rdfs:label "Software"@en .

cmpo:CMPToolComponent    rdfs:subClassOf cmpo:Tool ; #not needed mybe just tool or CMPTool
    rdfs:label "CMP Tool Component"@en .
cmpo:Platen          rdfs:subClassOf cmpo:CMPToolComponent ;
    rdfs:label "Platen"@en .
cmpo:RetainingRing   rdfs:subClassOf cmpo:CMPToolComponent ;
    rdfs:label "Retaining Ring"@en .
cmpo:WaferHead   rdfs:subClassOf cmpo:CMPToolComponent ; #also "carrier" (synonym)
    rdfs:label "Wafer Head"@en .
cmpo:Conditioner   rdfs:subClassOf cmpo:CMPToolComponent ;
    rdfs:label "Conditioner"@en .
cmpo:Chamber   rdfs:subClassOf cmpo:CMPToolComponent ;
    rdfs:label "Chamber"@en .
cmpo:SlurryPipe   rdfs:subClassOf cmpo:CMPToolComponent ;
    rdfs:label "Slurry Pipe"@en .
cmpo:ConditionerPad   rdfs:subClassOf cmpo:CMPToolComponent ;
    rdfs:label "Conditioner Pad"@en .

# is "conditioner Pad" the same as "Pad"? -- Pad as class and type of pad as an instance?

cmpo:Cleaner         rdfs:subClassOf cmpo:Tool ;
    rdfs:label "Cleaner"@en .

cmpo:SpectroscopicMeasurementTool         rdfs:subClassOf cmpo:Tool ;
    rdfs:label "Spectroscopic Measurement Tool"@en .

cmpo:PadConditioner  rdfs:subClassOf cmpo:Equipment ;
    rdfs:label "Pad Conditioner"@en .
cmpo:SlurryDeliveryPipe rdfs:subClassOf cmpo:Equipment ;
    rdfs:label "Slurry Delivery Pipe"@en .

#################################################################
### Consumables
#################################################################

cmpo:Consumable   rdfs:subClassOf cmpo:Tool ;
    rdfs:label "Consumable"@en .
cmpo:PolishingPad   rdfs:subClassOf cmpo:Consumable ;
    rdfs:label "Polishing Pad"@en .

cmpo:ConditionerPad   rdfs:subClassOf cmpo:Consumable .
cmpo:ConditionerPad   rdfs:subClassOf cmpo:Conditioner .
cmpo:Slurry   rdfs:subClassOf cmpo:Consumable ;
    rdfs:label "Slurry"@en .

cmpo:SlurryType  rdfs:subClassOf cmpo:Slurry ;
    rdfs:label "Slurry Type"@en .
cmpo:Klebosol   rdfs:subClassOf cmpo:SlurryType ; #instance
    rdfs:label "Klebosol"@en .

#################################################################
### Recipe and Data Source and Methodes #Information Content Entity iao:0000030
#################################################################

cmpo:Recipe   rdfs:subClassOf BFO:0000031 . # generically dependent continuant

cmpo:Recipe a rdfs:Class;
    rdfs:label "Recipe"@en ;
    rdfs:comment "recipe is collection of componants with specific (imput) parameters (conditioning pad with sweeps per minute)" .

    cmpo:ToolBreakInRecipe   rdfs:subClassOf BFO:Recipe ;
    rdfs:label "Tool Break-In Recipe"@en .

cmpo:OxideCMPRecipe   rdfs:subClassOf BFO:Recipe ;
    rdfs:label "Oxide CMP Recipe"@en .
cmpo:CleaningRecipe   rdfs:subClassOf BFO:Recipe ;
    rdfs:label "Cleaning Recipe"@en .

#cmpo:DataSource   rdfs:subClassOf BFO:0000031 .

#cmpo:MES   rdfs:subClassOf cmpo:DataSource .
#cmpo:ProcessCard   rdfs:subClassOf cmpo:DataSource .

#cmpo:ProcessCard   rdfs:subClassOf iao:0000310 .
#cmpo:ProcessBook   rdfs:subClassOf cmpo:DataSource .
#cmpo:ProcessBook   rdfs:subClassOf iao:0000310 .

cmpo:SpectroscopicMeasurementMethod   rdfs:subClassOf  iao:0000104 ; #Plan Specification eine Unterklasse von iao:0000030 (Information Content Entity)
    rdfs:label "Spectroscopic Measurement Method"@en .
cmpo:OpticalMeasurementMethod   rdfs:subClassOf  iao:0000104 ;
    rdfs:label "Optical Measurement Method"@en .
cmpo:VirtualMeasurementMethod   rdfs:subClassOf  iao:0000104 ;
    rdfs:label "Virtual Measurement Method"@en .

#################################################################
### Wafer & Properties
#################################################################

cmpo:DummyWafer rdfs:subClassOf cmpo:Wafer ;
    rdfs:label "Dummy Wafer"@en .
cmpo:ControlWafer rdfs:subClassOf cmpo:Wafer ;
    rdfs:label "Control Wafer"@en .
cmpo:StructuredWafer rdfs:subClassOf cmpo:Wafer ;
    rdfs:label "Structured Wafer"@en .

#cmpo:Layout   rdfs:subClassOf BFO:0000019 .  nur property
#bis zeile 134 als klasse nicht unterklasse
cmpo:WaferDiameter   a rdfs:Class ; # either 150 mm (6 Zoll), 200 mm (8 Zoll) und 300 mm (12 Zoll)
    rdfs:label "Wafer Diameter"@en .
#cmpo:WaferMaterialToRemove   rdfs:subClassOf cmpo:WaferProperty .
cmpo:WaferMaterial  a rdfs:Class ; #comes from  ProcessCard in our Project its Oxid has Name and Value
    rdfs:label "Wafer Material"@en .
cmpo:WaferLayerThickness   a rdfs:Class ; #measured with Metrology or documented in ProcessCard
    rdfs:label "Wafer Layer Thickness"@en .
#cmpo:WaferLayerThicknessPreProcess   rdfs:subClassOf cmpo:WaferMaterial. #measured with SpectroscopicMeasurementMethod by using FRTTool used to calculate MRR
#cmpo:WaferLayerThicknessPostProcess   rdfs:subClassOf cmpo:WaferMaterial . #measured with SpectroscopicMeasurementMethod used to calculate MRR

cmpo:WaferDefects   a rdfs:Class ;
    rdfs:label "Wafer Defects"@en .
#cmpo:WaferLayout   rdfs:subClassOf cmpo:WaferProperty .
cmpo:WaferRoughness  a  rdfs:Class ;
    rdfs:label "Wafer Roughness"@en .
cmpo:WaferUniformity   a rdfs:Class ;
    rdfs:label "Wafer Uniformity"@en .

#cmpo:WaferPreProcess   rdfs:subClassOf BFO:0000019 . # ?
#cmpo:WaferID   rdfs:subClassOf BFO:0000019 .
cmpo:WaferID a rdfs:Class ; #property belongs to lot
    rdfs:label "Wafer ID"@en .
cmpo:Lot a rdfs:Class . # every Wafer belongs to a WaferLot

#################################################################
### Process & Phases
#################################################################

cmpo:VisualInspection   rdfs:subClassOf BFO:0000015 ;
    rdfs:label "Visual Inspection"@en .

cmpo:Measurement   a rdfs:Class;
    rdfs:comment "all measurments methods, tools and data" .

cmpo:Metrology   rdfs:subClassOf cmpo:Measurement;
    rdfs:label "Metrology"@en ;
    rdfs:comment "all measurement data and methods" .

#different stages of measurement can be instances and can be idetified as pre, insitu or post by looking at the time stemp
#cmpo:ExSituMetrology   rdfs:subClassOf cmpo:Metrology . #uses measurement methodes
#cmpo:PostProcessMetrology   rdfs:subClassOf cmpo:ExSituMetrology . #uses SpectroscopicMeasurementMethod
#cmpo:InSituMetrology   rdfs:subClassOf cmpo:Metrology . #uses

#cmpo:ProcessInTool   rdfs:subClassOf cmpo:CMPProcess  .
#cmpo:OxideCMPProcess   rdfs:subClassOf cmpo:ProcessInTool  .
#cmpo:CMPPhase        rdfs:subClassOf BFO:ProcessInTool .
#cmpo:Phase1Loading    rdfs:subClassOf cmpo:CMPPhase .
#cmpo:Phase2Polishing    rdfs:subClassOf cmpo:CMPPhase .
#cmpo:Phase3Dechucking    rdfs:subClassOf cmpo:CMPPhase .
#cmpo:Phase4Unloading    rdfs:subClassOf cmpo:CMPPhase .
#cmpo:Phase5Cycling     rdfs:subClassOf cmpo:CMPPhase .
#cmpo:Phase6EndingCycling    rdfs:subClassOf cmpo:CMPPhase .
cmpo:ToolBreakIn       rdfs:subClassOf BFO:0000015 ;
    rdfs:label "Tool Break-In"@en .
cmpo:CleaningPhase       rdfs:subClassOf BFO:0000015 ;
    rdfs:label "Cleaning Phase"@en .

#################################################################
### Agents & Roles
#################################################################

cmpo:LotOwner   rdfs:subClassOf BFO:0000023 ; # BFO:Role synonym contact person
    rdfs:label "Lot Owner"@en .
cmpo:ToolExpert   rdfs:subClassOf BFO:0000023 ; #technican
    rdfs:label "Tool Expert"@en .
cmpo:ProcessExpert   rdfs:subClassOf BFO:0000023 ;
    rdfs:label "Process Expert"@en .

cmpo:CMPExpert   rdfs:subClassOf cmpo:ProcessExpert ;
    rdfs:label "CMP Expert"@en .

#cmpo:ProcessEngineer rdfs:subClassOf cmpo:Agent .
#cmpo:Student         rdfs:subClassOf cmpo:Agent .
#cmpo:Worker          rdfs:subClassOf cmpo:Agent .
#cmpo:EngineerRole    rdfs:subClassOf cmpo:Role .
#cmpo:WorkerRole      rdfs:subClassOf cmpo:Role .

#################################################################
### Parameters (Qualities)
#################################################################

#cmpo:Parameter       rdfs:subClassOf cmpo:Parameter .
#cmpo:Parameter       rdfs:subClassOf cmpo:Parameter .
#cmpo:Parameter       rdfs:subClassOf cmpo:Parameter .

#################################################################
###  Parameters (Qualities)
#################################################################

# better only Parameter not , Disturbance or
cmpo:Pressure       rdfs:subClassOf cmpo:Parameter ;
    rdfs:label "Pressure"@en .
cmpo:ProcessTime       rdfs:subClassOf cmpo:Parameter ; # set in Recipe for each CMPPhase and for CleaningRecipe
    rdfs:label "Process Time"@en .
cmpo:SlurryFlow       rdfs:subClassOf cmpo:Parameter ; #Data property: ml
    rdfs:label "Slurry Flow"@en .
cmpo:SlurryType       rdfs:subClassOf cmpo:Parameter ;
    rdfs:label "Slurry Type"@en .
cmpo:Conditioning       rdfs:subClassOf cmpo:Parameter ; #Data property: Sweeps per min
    rdfs:label "Conditioning"@en .
cmpo:Temperature       rdfs:subClassOf cmpo:Parameter ;
    rdfs:label "Temperature"@en .
cmpo:Velocity      rdfs:subClassOf cmpo:Parameter ;
    rdfs:label "Velocity"@en .

cmpo:PolishingTime    rdfs:subClassOf cmpo:ProcessTime ;
    rdfs:label "Polishing Time"@en .

cmpo:ContitioningPressure      rdfs:subClassOf cmpo:Conditioning ; #part of the Recipe Value Sweeps per Minute, in CMPPhase2 and ToolBreakIn
    rdfs:label "Conditioning Pressure"@en .
cmpo:ContitioningSweeps      rdfs:subClassOf cmpo:Conditioning ; #part of the Recipe Value Sweeps per Minute, in CMPPhase2 and ToolBreakIn
    rdfs:label "Conditioning Sweeps"@en .

cmpo:HeadPressure       rdfs:subClassOf cmpo:Pressure ;
    rdfs:label "Head Pressure"@en .
cmpo:DownForcePressure      rdfs:subClassOf cmpo:Pressure ;
    rdfs:label "Down Force Pressure"@en .
cmpo:InnerTubePressure       rdfs:subClassOf cmpo:Pressure ;
    rdfs:label "Inner Tube Pressure"@en .
cmpo:RetainingRingPressure       rdfs:subClassOf cmpo:Pressure ;
    rdfs:label "Retaining Ring Pressure"@en ;
    rdfs:comment "depenting on tool, RR-pressure can have a number of different zones and each zone could have its own pressure value" . # FIX: Changed redfs:comment to rdfs:comment (typo fix)

cmpo:PadTemperature     rdfs:subClassOf cmpo:Temperature ;
    rdfs:label "Pad Temperature"@en .

cmpo:PlatenSpeed     rdfs:subClassOf cmpo:Velocity ;
    rdfs:label "Platen Speed"@en .
cmpo:HeadSpeed     rdfs:subClassOf cmpo:Velocity ;  #synonym CarrierSpeed
    rdfs:label "Head Speed"@en .

#################################################################
###  Parameters (Qualities)
#################################################################

cmpo:WaferMaterial       rdfs:subClassOf cmpo:Parameter . #is a Wafer Propery and Material that has to be removed, and its connected to PreProcesses
cmpo:WaferMaterialRemovalRate       rdfs:subClassOf cmpo:Parameter ;
    rdfs:label "Wafer Material Removal Rate"@en .
cmpo:WaferUniformity       rdfs:subClassOf cmpo:Parameter .
cmpo:WaferRoughness       rdfs:subClassOf cmpo:Parameter .
cmpo:WaferLayerThicknessPostProcess rdfs:subClassOf cmpo:Parameter ;
    rdfs:label "Wafer Layer Thickness Post Process"@en .

#################################################################
###  Parameters (Dispositions)
#################################################################

cmpo:WaferProperty       rdfs:subClassOf cmpo:Parameter ; #to general?
    rdfs:label "Wafer Property"@en .
cmpo:PadLifetime       rdfs:subClassOf cmpo:Parameter ;
    rdfs:label "Pad Lifetime"@en .
cmpo:SlurryCharge      rdfs:subClassOf cmpo:Parameter ;
    rdfs:label "Slurry Charge"@en .
cmpo:RetainingRingLifetime       rdfs:subClassOf cmpo:Parameter ;
    rdfs:label "Retaining Ring Lifetime"@en .
cmpo:MotorCurrent       rdfs:subClassOf cmpo:Parameter ;
    rdfs:label "Motor Current"@en .

