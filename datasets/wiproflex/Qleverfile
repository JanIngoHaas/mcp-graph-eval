[data]
NAME         = wiproflex
GET_DATA_CMD = cat ./ontology_v2.ttl ./instances_v2.ttl
DESCRIPTION  = "Wiproflex Synthetic CMP Graph"

[index]
INPUT_FILES     = ./ontology_v2.ttl ./instances_v2.ttl
CAT_INPUT_FILES = cat ${INPUT_FILES}

[server]
PORT         = 7001
ACCESS_TOKEN = wiproflex-secret

[runtime]
SYSTEM = docker
IMAGE  = docker.io/adfreiburg/qlever:latest

[ui]
UI_PORT   = 7002
UI_CONFIG = default
