    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/c7d22f32-f8a1-4969-a757-d5f912821d9e> a hypmol:ProcedureStep ;
    hypmol:observation "Strong effervescence, and solution slowly turned clear." ;
    hypmol:procedureDate "2025-11-28"^^xsd:date ;
