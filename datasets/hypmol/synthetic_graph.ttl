    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/6bf6a420-447a-4cf1-abf3-4f06c1bb7cef> a hypmol:ProcedureStep ;
    hypmol:observation "Start material disappears, new spot with R_f = 0.35 appears." ;
    hypmol:procedureDate "2026-01-07"^^xsd:date ;
    hypmol:stepDescription "Heat under reflux for 6 h, monitoring by TLC (hexane/EtOAc 9:1)." ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/6c9758f1-3e27-4676-97b7-2c990335cbec> a hypmol:ProcedureStep ;
    hypmol:observation "Spectra confirm" ;
    hypmol:procedureDate "2025-12-03"^^xsd:date ;
    hypmol:stepDescription "Characterise by ^1H NMR (CDCl₃) and HRMS (ESI). HRMS m/z calc. C₂₈H₂₆N₂O₂S⁺ [M + H]⁺: 506.1534; found 506.1532." ;
    hypmol:stepOrder 4 .

<https://hypmol.net/ProcedureStep/6d3972e0-5076-4f5d-8c93-e434d8e88d5d> a hypmol:ProcedureStep ;
    hypmol:observation "The spot shifts towards the solvent front." ;
    hypmol:procedureDate "2026-01-15"^^xsd:date ;
    hypmol:stepDescription "Add 20 µL of a 0.1 M iron(III) chloride solution in hexane dropwise under N₂; stir for 3 h at 40 °C. Monitor reaction by TLC (R_f 0.39 in hexane/EtOAc = 8/1)." ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/6dbacdb3-3d02-4c41-9dd8-426bb665f18e> a hypmol:ProcedureStep ;
    hypmol:observation "The solution thickens to a viscous gel." ;
    hypmol:procedureDate "2024-08-24"^^xsd:date ;
    hypmol:stepDescription "Allow the reaction to warm to room temperature and continue stirring for 12 h. Then add 0.8 g (0.75 mmol) of bis(1,3‑diphenyl‑2‑pyridyl)disulfane (C) and a catalytic amount of 1 mol % (NH₄)₂SO₄ to promote cross‑linking. Heat the mixture to reflux (110 °C) for 6 h, monitoring viscosity increase." ;
    hypmol:stepOrder 3 .

<https://hypmol.net/ProcedureStep/6e0dfc62-4e2b-4bbb-806c-2fa91ecaaf3a> a hypmol:ProcedureStep ;
    hypmol:observation "final yield: 0.320 g (70 % theoretical)" ;
