<https://hypmol.net/ProcedureStep/6afeadb5-30f2-49e9-bbdc-e8a9167aa55d> a hypmol:ProcedureStep ;
    rdfs:label "Quench with 20 mL saturated NH₄Cl, extract the organic layer, dry over Na₂SO₄, and concentrate." ;
