    hypmol:procedureDate "2025-09-15"^^xsd:date ;
    hypmol:stepDescription "Dissolve 0.150 g of (e)-1,2‑difluoro‑3‑tert‑butyl‑prop‑2‑en‑1‑yl nitroxide and 0.050 g of tetraethylammonium 4-(dimethylamino)benzoate in the acetonitrile, stir for 5 min to obtain a homogeneous orange solution." ;
