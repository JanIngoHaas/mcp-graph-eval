    rdfs:label "Femtosecond Transient Absorption measurement" ;
    hypmol:measurementMethod "Femtosecond Transient Absorption" ;
    hypmol:measurementResult "Singlet excited state lifetime 450 fs; triplet state formed with 12 ps decay." .

