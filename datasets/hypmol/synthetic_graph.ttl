    hypmol:procedureDate "2025-10-31"^^xsd:date ;
    hypmol:stepDescription "Place the cuvette in the EPR resonator, set magnetic field to 0 mT, and fire the laser (10 ns pulse, 1 mJ). Record the transient EPR signal for 5 µs." ;
