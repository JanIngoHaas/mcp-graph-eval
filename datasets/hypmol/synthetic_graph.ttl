    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/6ec362c8-915a-45e7-8d99-078c7b46cf2c> a hypmol:ProcedureStep ;
    hypmol:observation "Ethereal vapor is released, solution turns slightly more yellow, no precipitate forms." ;
    hypmol:procedureDate "2025-08-01"^^xsd:date ;
    hypmol:stepDescription "Sodium carbonate (1.50 g, 16.8 mmol, 2.2 equiv) is added portion‑wise while maintaining the temperature at 30 °C by an ice‑bath. The mixture is stirred for 2 h, then the temperature is raised gradually to 60 °C and allowed to reflux for an additional 4 h." ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/6f35d2c9-9f10-40a7-90cf-6c930d57774b> a hypmol:ProcedureStep ;
    hypmol:observation "TLC indicates completion" ;
    hypmol:procedureDate "2025-06-08"^^xsd:date ;
    hypmol:stepDescription "Allow the reaction to warm to room temperature and stir for 2 h. Monitor the progress by TLC (EtOAc/hexane 1:1). The spot for starting material disappears while a new spot (R_f 0.45) appears. " ;
    hypmol:stepOrder 3 .

<https://hypmol.net/ProcedureStep/6f53dcd9-f1ec-47a1-819e-29ab9d6e050e> a hypmol:ProcedureStep ;
    hypmol:observation "Liquid, density 0.85 g mL⁻¹." ;
    hypmol:procedureDate "2026-01-12"^^xsd:date ;
