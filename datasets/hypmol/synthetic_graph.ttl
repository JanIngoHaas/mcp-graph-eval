<https://hypmol.net/Dataset/cfcc7093-11c6-43f0-8bfb-97a4ad5329ad> a schema1:Dataset ;
    rdfs:label "SpinChem-001: Magnetic‑field dependence of radical‑pair recombination (nitroxide/fluoro‑aryl system)" ;
