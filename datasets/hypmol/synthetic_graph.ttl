<https://hypmol.net/Dataset/ef6d06f4-7828-495c-8053-3c4ebaa0d6f7> a schema1:Dataset ;
    rdfs:label "Spin‑Chemistry Magnetic‑Field Effect on a Fluoro‑Radical Pair" ;
    schema1:author <https://hypmol.net/Person/0acbf61a-ba82-40b6-8837-0f1fe8a4308e> ;
