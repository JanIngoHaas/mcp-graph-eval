    schema1:name "SpinChem‑Dataset‑003 – Magnetic Isotope Effect in Cyclobutyl‑Palladium‑Catalyzed C‑C Coupling" ;
    schema1:text "The ¹⁰⁶Pd‑enriched catalyst gave a 12 % faster initial rate compared with the natural‑abundance catalyst, supporting a hyperfine‑mediated transition‑state effect." ;
    schema1:url "https://example.org/datasets/SC003"^^xsd:anyURI ;
    hypmol:hasExperiment <https://hypmol.net/Experiment/c389791c-5aca-4935-be67-e0067f34c755> .

