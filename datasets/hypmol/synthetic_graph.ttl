    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/c43c4854-3d79-4613-9e50-d9a71439a159> a hypmol:ProcedureStep ;
    hypmol:observation "Solid appears after addition of ether." ;
    hypmol:procedureDate "2025-12-02"^^xsd:date ;
    hypmol:stepDescription "The mixture is allowed to stir at RT for 5 h. After completion (TLC), the solvent is removed under reduced pressure, and the crude residue is triturated with cold diethyl ether (2 × 10 mL) to give the desired acylated product as a pale solid." ;
    hypmol:stepOrder 3 .

<https://hypmol.net/ProcedureStep/c483cd0e-ae72-4f68-a8d0-f94323aa690a> a hypmol:ProcedureStep ;
    hypmol:observation "TLC shows complete disappearance of the starting epoxide and formation of a new product spot." ;
    hypmol:procedureDate "2025-11-03"^^xsd:date ;
    hypmol:stepDescription "Heat the mixture to 80 °C and stir for 6 h while monitoring by TLC." ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/c58eb10a-a876-44c5-b034-e28ab5409605> a hypmol:ProcedureStep ;
    hypmol:observation "Mixture is homogeneous yellow solution." ;
    hypmol:procedureDate "2025-01-15"^^xsd:date ;
    hypmol:stepDescription "Charge the autoclave with 1.5 g (0.006 mol) dibenzyl 3‑iodopropan‑1‑yl carbamate, 0.8 g (0.004 mol) 2‑(bis(1,2,4‑triazolyl)phosphine), 1.0 g (0.0035 mol) Cu(OAc)₂, and 20 mL dry acetonitrile. Seal and purge with nitrogen 3×." ;
    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/c679847c-bf0e-42d6-be0f-5928a55458a9> a hypmol:ProcedureStep ;
    hypmol:observation "White slurry forms" ;
    hypmol:procedureDate "2025-04-12"^^xsd:date ;
    hypmol:stepDescription "Slowly add n‑butyllithium (1.6 M, 1200 µL, 1.92 mmol) drop‑wise over 10 min while stirring. Maintain the temperature at 0 °C. Observation: formation of a light turbid white precipitate. Maintain for 30 min to allow completion of lithiation. " ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/c6cfd8f8-a5aa-4df7-a37c-aaaa579149d5> a hypmol:ProcedureStep ;
    hypmol:observation "Formation of a new colored product in the flask." ;
    hypmol:procedureDate "2025-12-01"^^xsd:date ;
