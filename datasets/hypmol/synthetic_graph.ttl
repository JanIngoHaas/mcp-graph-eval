<https://hypmol.net/ProcedureStep/a930729e-3b36-4f7f-af22-68d12a6ba912> a hypmol:ProcedureStep ;
    rdfs:label "Prepare 20 mL of anhydrous acetonitrile solution containing 0.050 g (0.28 mmol) of bis(2,3,4,5-tetrafluorophenyl) ether and 0.025 g (0.12 mmol) of (e)-1,2‑difluoro‑3‑tert‑butyl‑prop‑2‑en‑1‑yl nitroxide in a dry Schlenk flask under nitrogen." ;
    hypmol:observation "Solution became pale yellow and remained clear." ;
    hypmol:procedureDate "2025-11-21"^^xsd:date ;
