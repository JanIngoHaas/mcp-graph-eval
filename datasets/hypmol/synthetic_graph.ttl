<https://hypmol.net/ProcedureStep/a9e21406-f1d2-4c47-9b49-ae983c6b803c> a hypmol:ProcedureStep ;
    rdfs:label "Transfer the solution into a quartz EPR cuvette, seal with a PTFE stopper, and place the cuvette in the temperature‑controlled holder at 298 K." ;
    hypmol:observation "No bubble formation; temperature stabilized at 298 K." ;
    hypmol:procedureDate "2025-11-30"^^xsd:date ;
    hypmol:stepDescription "Transfer the solution into a quartz EPR cuvette, seal with a PTFE stopper, and place the cuvette in the temperature‑controlled holder at 298 K." ;
