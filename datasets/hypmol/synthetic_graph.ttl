    hypmol:stepDescription "Add 4.00 g (7.30 mmol) of 2‑(dichloromethyl)phenyl‑1,3,5‑triazin‑4(1h)-one to a dry 10 mL sealed tube." ;
    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/60c3278a-6cac-4681-9a53-6a0ec0e81714> a hypmol:ProcedureStep ;
    hypmol:observation "Organic layer is clear." ;
    hypmol:procedureDate "2025-11-09"^^xsd:date ;
    hypmol:stepDescription "Cool to room temperature, add 15 mL of water, extract with ethyl acetate (3×20 mL). Dry over Na2SO4." ;
    hypmol:stepOrder 3 .

<https://hypmol.net/ProcedureStep/60da9fa6-ba9f-43e2-b976-d1b0464c2808> a hypmol:ProcedureStep ;
    hypmol:observation "Upper layer is clear, showing orange color." ;
    hypmol:procedureDate "2024-11-18"^^xsd:date ;
