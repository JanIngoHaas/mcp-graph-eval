<https://hypmol.net/ProcedureStep/d9029c21-07af-42c4-b2ee-61f4326b1d32> a hypmol:ProcedureStep ;
    rdfs:label "Repeat the measurement at magnetic fields 0.05 T, 0.10 T, and 0.20 T, recording the decay constants at each field." ;
