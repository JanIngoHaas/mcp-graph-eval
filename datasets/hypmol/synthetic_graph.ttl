<https://hypmol.net/ProcedureStep/a949a43f-9d3b-4f84-89a2-86e8e8116703> a hypmol:ProcedureStep ;
    rdfs:label "Stir at 80 °C for 4 h; monitor reaction progress by TLC (hexane/ethyl acetate = 7:3)." ;
    hypmol:observation "Full conversion observed after 3 h; product spot Rf = 0.58." ;
    hypmol:procedureDate "2025-10-22"^^xsd:date ;
    hypmol:stepDescription "Stir at 80 °C for 4 h; monitor reaction progress by TLC (hexane/ethyl acetate = 7:3)." ;
