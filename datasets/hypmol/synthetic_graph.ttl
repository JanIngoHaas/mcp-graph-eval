    hypmol:stepOrder 3 .

<https://hypmol.net/ProcedureStep/6e96a524-bc20-40c3-ae2f-ecd9979759f7> a hypmol:ProcedureStep ;
    hypmol:observation "Solution becomes clear and homogenous." ;
    hypmol:procedureDate "2024-08-23"^^xsd:date ;
    hypmol:stepDescription "In a dry 250 mL Schlenk flask, add 2.5 g (0.5 mmol) of tris(3‑tert‑butylphenyl)silane (A) and 4 mL of dry toluene under argon. Cool the mixture to 0 °C using an ice bath." ;
    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/6ea9d5ad-9704-4d7a-a43a-f5416f16c23c> a hypmol:ProcedureStep ;
    hypmol:observation "Observed slight fizzing during NaH addition, then solution color changed to pale yellow." ;
    hypmol:procedureDate "2024-07-22"^^xsd:date ;
