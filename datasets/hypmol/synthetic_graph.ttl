<https://hypmol.net/ProcedureStep/69226a8d-63eb-4ce9-8243-e914e77c7d66> a hypmol:ProcedureStep ;
    hypmol:observation "Solution clear; both reagents dissolved nicely." ;
    hypmol:procedureDate "2024-06-15"^^xsd:date ;
    hypmol:stepDescription "Add 0.16 g (0.18 mmol) of N,N′‑bis(3‑chloro‑4‑methyl‑2‑pyridyl)carbamimidic acid and 0.24 g (0.30 mmol) of 1‑bromomethyl‑pyrrolidine in 6 mL dry acetonitrile." ;
    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/6949484d-c9d8-43c3-93bd-5d49b7f43141> a hypmol:ProcedureStep ;
    hypmol:observation "Flame-dried flask shows no condensation over 5 min." ;
    hypmol:procedureDate "2026-01-15"^^xsd:date ;
    hypmol:stepDescription "Dry the 3 L round‑bottom flask under vacuum with a flame-dried cover and place a magnetic stir bar." ;
    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/69d989e1-c84d-41ad-a95e-8efdfc7d63a4> a hypmol:ProcedureStep ;
    hypmol:observation "Flask turns white as it is baked, indicating dryness." ;
    hypmol:procedureDate "2025-06-12"^^xsd:date ;
    hypmol:stepDescription "Dry a 250 mL round‑bottom flask under vacuum, evacuate and back‑fill with dry N₂." ;
    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/69f44ca9-da45-4859-a343-05201bb4b586> a hypmol:ProcedureStep ;
    hypmol:observation "Solution is pale yellow; no precipitation." ;
    hypmol:procedureDate "2025-10-12"^^xsd:date ;
    hypmol:stepDescription "In a 35‑mL quartz tube, combine 0.5 g (0.0025 mol) of (4‑(tert‑butyl)phenyl)­bis(2,4,6‑trimethoxy‑1h‑imidazol‑2‑yl)‑pyrimidine‑3‑yl acetate, 0.78 g (0.005 mol) of 4‑(tert‑butyl)phenyl­methyl‑sulfide, and 1.2 g (0.004 mol) of 1‑cyano‑2‑bromopropane in 10 mL dry acetonitrile. Seal the tube and add a magnetic stir bar." ;
    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/6a7ee6fd-f35a-4744-b943-d39a9e305ebd> a hypmol:ProcedureStep ;
    hypmol:observation "Solvent turned turbid; after 6 h it cleared again. Reaction progressed under anhydrous conditions." ;
    hypmol:procedureDate "2024-05-02"^^xsd:date ;
    hypmol:stepDescription "Add 1.2 mmol (3.4 g, 3.2 eq) of Cs₂CO₃. Stir at 80 °C for 12 h." ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/6b1ba556-25cc-4bc3-b79a-12085203d7df> a hypmol:ProcedureStep ;
    hypmol:observation "The solution is a pale yellow liquid." ;
    hypmol:procedureDate "2025-11-09"^^xsd:date ;
