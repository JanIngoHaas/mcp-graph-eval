<https://hypmol.net/ProcedureStep/32582935-df9a-40e7-84e3-af4b0068478d> a hypmol:ProcedureStep ;
    rdfs:label "Seal flask, purge with nitrogen for 10 min, then irradiate with 440 nm LED (30 W) while maintaining 30 °C for 4 h." ;
