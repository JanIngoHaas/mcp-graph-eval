    schema1:name "SpinChem‑ISC‑BisHydroxy‑2025‑C" ;
    schema1:text "Applying a 150 mT field increased the triplet quantum yield from 0.23 to 0.31, consistent with a field‑enhanced ISC pathway mediated by spin‑orbit coupling from the heavy‑atom‑substituted phenyl rings." ;
    schema1:url "https://spinlab.org/dataset/SC-ISC-03"^^xsd:anyURI ;
    hypmol:hasExperiment <https://hypmol.net/Experiment/4a7013a5-a382-4cea-a2c8-562fc36c4122> .

