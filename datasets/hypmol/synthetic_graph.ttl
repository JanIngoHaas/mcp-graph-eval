<https://hypmol.net/ProcedureStep/322aa0c2-0c87-4687-a489-91a1cbeb7676> a hypmol:ProcedureStep ;
    rdfs:label "Add 0.50 g (2.5 mmol) of tris(2‑amino‑3,4,5‑trimethylphenyl)methane and 0.30 mL diethylamine; stir at 60 °C for 12 h." ;
    hypmol:observation "Complete consumption of starting alkyne by TLC (hexane/ethyl acetate 3:1)." ;
    hypmol:procedureDate "2025-04-20"^^xsd:date ;
    hypmol:stepDescription "Add 0.50 g (2.5 mmol) of tris(2‑amino‑3,4,5‑trimethylphenyl)methane and 0.30 mL diethylamine; stir at 60 °C for 12 h." ;
