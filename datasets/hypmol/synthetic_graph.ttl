    hypmol:stepOrder 5 .

<https://hypmol.net/ProcedureStep/c2d1af1f-9e89-440d-9d9d-12fadfc22b04> a hypmol:ProcedureStep ;
    hypmol:observation "reaction mixture becomes viscous" ;
