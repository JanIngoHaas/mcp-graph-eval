    schema1:datePublished "2025-12-05T14:20:00+00:00"^^xsd:dateTime ;
    schema1:description "Examination of spin‑polarized catalytic hydrogenation using a cyclobutyl‑palladium complex to reduce 4-(2‑hydroxyethyl)morpholine while monitoring transient radical spin states." ;
    schema1:encodingFormat "application/json" ;
    schema1:genre "Spin Chemistry" ;
    schema1:identifier "SC‑HYD‑042" ;
    schema1:keywords "GC‑MS",
        "hydrogenation",
