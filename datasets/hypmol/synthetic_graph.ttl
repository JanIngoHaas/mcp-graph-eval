    hypmol:stepOrder 4 .

<https://hypmol.net/ProcedureStep/5c8e0396-ff4d-4d35-b94f-39da07b7b596> a hypmol:ProcedureStep ;
    hypmol:observation "Yield 79 %" ;
    hypmol:procedureDate "2025-12-02"^^xsd:date ;
    hypmol:stepDescription "Cool, dilute with EtOAc (50 mL), wash with water and brine, dry over Na₂SO₄, filter, concentrate. Purify via silica gel chromatography (hexane/EtOAc 8:1) to afford 0.280 g of the desired ester (79 %)." ;
    hypmol:stepOrder 3 .

<https://hypmol.net/ProcedureStep/5c9404c3-85fc-466f-a1da-b2543d4a5df3> a hypmol:ProcedureStep ;
    hypmol:observation "foaming and gas evolution starts" ;
    hypmol:procedureDate "2025-11-20"^^xsd:date ;
    hypmol:stepDescription "Combine 0.200 g (0.55 mmol) of the tetrahydropyran substrate with 0.100 g (0.30 mmol) of bis(3,5‑difluoro‑4‑methylphenyl)oxazolidin‑2‑one in a dry 50 mL round‑bottom flask.  Add 5 mmol of NaH (60 % dispersion in mineral oil) to deprotonate the substrate." ;
    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/5d6b2448-b174-40f9-89ce-0f5b5c46bb1e> a hypmol:ProcedureStep ;
    hypmol:observation "A light yellow precipitate forms upon addition." ;
    hypmol:procedureDate "2026-01-15"^^xsd:date ;
    hypmol:stepDescription "Add 50 mL dry THF and cool to –10 °C. Prepare a solution of 0.1 M BF₃·Et₂O in THF (5 mL) and add it dropwise over 30 min under vigorous stirring." ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/5da9a434-f492-4afb-98c3-34bd2e95b3fa> a hypmol:ProcedureStep ;
    hypmol:observation "Residue is a pale crude mixture." ;
    hypmol:procedureDate "2025-11-03"^^xsd:date ;
    hypmol:stepDescription "After cooling to RT, the mixture is poured onto saturated NH₄Cl and extracted with EtOAc (2 × 20 mL). The organic layer is washed with brine, dried, filtered and concentrated." ;
    hypmol:stepOrder 3 .

<https://hypmol.net/ProcedureStep/5e0ae40b-3e3d-479a-bc67-21db79a9f32b> a hypmol:ProcedureStep ;
    hypmol:observation "Bubbles ceased after 15 min; solution cleared as the base consumed HCl." ;
    hypmol:procedureDate "2025-09-12"^^xsd:date ;
    hypmol:stepDescription "Introduce 2.0 g (0.01 mol) of NaHCO₃ as a mild base to neutralize the HCl formed. Stir for an additional 2 h at room temperature." ;
    hypmol:stepOrder 3 .

<https://hypmol.net/ProcedureStep/5e17ee3b-b432-4b89-9879-88f662e3c0f6> a hypmol:ProcedureStep ;
    hypmol:observation "A pale yellow oil is obtained after concentration." ;
    hypmol:procedureDate "2025-12-22"^^xsd:date ;
    hypmol:stepDescription "Quench with saturated NaHCO₃, extract with EtOAc, dry over Na₂SO₄, filter, evaporate." ;
    hypmol:stepOrder 3 .

<https://hypmol.net/ProcedureStep/5e868d7b-7030-4224-b198-a83d6b2afa01> a hypmol:ProcedureStep ;
    hypmol:observation "Yield: 140 mg (70 %)" ;
    hypmol:procedureDate "2025-04-13"^^xsd:date ;
    hypmol:stepDescription "Extract the product with ethyl acetates (3 × 20 mL). Wash the combined organic layer with brine, dry over Na₂SO₄, filter and concentrate under reduced pressure. Flash chromatography on silica gel (hexane/ethyl acetate 4:1) gives 4-(tert‑butyl)phenyl)methoxy‑n,n′‑dimethyl‑pyridinium chloride as a white solid. " ;
    hypmol:stepOrder 4 .

<https://hypmol.net/ProcedureStep/5e8d4efd-7b15-469d-ad70-002e07e01d9b> a hypmol:ProcedureStep ;
    hypmol:observation "After 2 h, a new spot with Rf = 0.45 appeared, corresponding to free 4‑tert‑butyl‑pyridine." ;
    hypmol:procedureDate "2025-11-25"^^xsd:date ;
