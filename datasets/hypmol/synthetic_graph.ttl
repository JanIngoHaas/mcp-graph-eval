<https://hypmol.net/Dataset/0ab385f9-da39-442a-ac00-4c624924c7c1> a schema1:Dataset ;
    rdfs:label "Photocatalytic Spin‑Selective Synthesis of 4‑(2‑hydroxyethyl)morpholine via Triplet‑Triplet Energy Transfer" ;
    schema1:author <https://hypmol.net/Person/123277ea-15e3-41ad-993c-0baf5880447b> ;
    schema1:dateCreated "2025-11-01T08:15:00+00:00"^^xsd:dateTime ;
