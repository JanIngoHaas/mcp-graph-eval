    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/5bd94769-3c99-4127-a097-d51f6808b15b> a hypmol:ProcedureStep ;
    hypmol:observation "Crude product collected as off‑white solid." ;
    hypmol:procedureDate "2024-07-08"^^xsd:date ;
