        "radical‑pair" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
    schema1:name "Spin‑Chemistry Magnetic‑Field Effect on a Fluoro‑Radical Pair" ;
    schema1:text "A 0.1 M solution of the nitroxide radical in tetrafluoroethylbenzene was examined by EPR while a Helmholtz coil supplied fields from 0 to 0.6 T. The singlet‑triplet intersystem crossing rate increased proportionally with field strength." ;
    schema1:url "https://example.org/datasets/SC-MAGF-001"^^xsd:anyURI ;
    hypmol:hasExperiment <https://hypmol.net/Experiment/fbbf3841-1711-4588-b1db-53a4d7fa346c> .

