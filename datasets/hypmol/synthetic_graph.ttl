    hypmol:stepOrder 4 .

<https://hypmol.net/ProcedureStep/6b50b843-568f-46c7-bcbf-e471bb879e50> a hypmol:ProcedureStep ;
    hypmol:observation "Solution becomes clear after extraction." ;
    hypmol:procedureDate "2026-01-11"^^xsd:date ;
    hypmol:stepDescription "The reaction is quenched by adding sat. NH₄Cl and extracted with EtOAc (3 × 15 mL). The organic phases are washed with brine, dried (Na₂SO₄), filtered and concentrated." ;
    hypmol:stepOrder 3 .

<https://hypmol.net/ProcedureStep/6bbad70d-b792-4981-b027-bf2444a06b0e> a hypmol:ProcedureStep ;
    hypmol:observation "A pink precipitate forms during the reaction." ;
    hypmol:procedureDate "2025-04-15"^^xsd:date ;
    hypmol:stepDescription "Under nitrogen, add 0.02 g (0.12 mmol) of N‑bromosuccinimide (NBS) portionally over 10 min. Allow the mixture to warm slowly to room temperature and stir for 4 h." ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/6bedeb54-6572-47e5-a150-53d4cbf87e98> a hypmol:ProcedureStep ;
    hypmol:observation "Solution is clear and pale yellow." ;
    hypmol:procedureDate "2025-05-01"^^xsd:date ;
