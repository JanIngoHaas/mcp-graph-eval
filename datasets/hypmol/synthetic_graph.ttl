    hypmol:stepOrder 4 .

<https://hypmol.net/ProcedureStep/6fa1be0f-a458-4b08-9375-367a6fb5efbe> a hypmol:ProcedureStep ;
    hypmol:observation "Melting point 98–100 °C." ;
