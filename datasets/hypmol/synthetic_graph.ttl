<https://hypmol.net/ProcedureStep/5acfeaff-ac96-49dd-bfeb-d31ca6e2d620> a hypmol:ProcedureStep ;
    hypmol:observation "Solution becomes clear yellow with mild CO₂ evolution." ;
    hypmol:procedureDate "2026-01-02"^^xsd:date ;
