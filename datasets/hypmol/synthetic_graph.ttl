    hypmol:stepDescription "Suspend 0.80 g (0.0035 mol) of bis(3,5‑difluoro‑4‑methylphenyl)oxazolidin‑2‑one thioester in 25 mL of 10 mM phosphate buffer pH 7.4, add 2 mg (0.001 µmol) of the lactonase enzyme solution, and place vial on shaker at 25 °C." ;
    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/65b04924-0fd4-4182-a505-1e285f090cf0> a hypmol:ProcedureStep ;
    hypmol:observation "Obtained a pale yellow liquid (1.7 g)." ;
    hypmol:procedureDate "2025-11-06"^^xsd:date ;
    hypmol:stepDescription "Quench with 30 mL ice‑cold water, extract with toluene, dry organic layer over Na₂SO₄, filter and concentration under reduced pressure." ;
    hypmol:stepOrder 4 .

<https://hypmol.net/ProcedureStep/660e6514-ebc9-4e0b-8f8e-ee724d4f1fe4> a hypmol:ProcedureStep ;
    hypmol:observation "Oil boiled with vigorous frothing." ;
    hypmol:procedureDate "2025-12-07"^^xsd:date ;
    hypmol:stepDescription "Add 0.5 g (3.0 mmol, 3.0 equiv) of N,N‑dimethylformamide‑dimethyl acetal to act as a dehydrating additive; ignite a Dean‑Stark trap to remove water." ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/6671eae1-4423-40dd-8af7-dd8f169fb487> a hypmol:ProcedureStep ;
    hypmol:observation "NMR shows disappearance of starting material and appearance of new peak." ;
    hypmol:procedureDate "2026-01-15"^^xsd:date ;
    hypmol:stepDescription "Allow the reaction to warm to 0 °C and stir for 2 h. Monitor the reaction by ^31P NMR (δ + 120 ppm for the starting reagent, new signal at δ + 55 ppm for the ring)." ;
    hypmol:stepOrder 3 .

<https://hypmol.net/ProcedureStep/6799511b-8ed0-4544-8d1c-46bcb0ed3013> a hypmol:ProcedureStep ;
    hypmol:observation "Clear pale‑yellow crystals form after solvent removal." ;
    hypmol:procedureDate "2025-06-13"^^xsd:date ;
    hypmol:stepDescription "Purify the crude product by flash chromatography on silica using a hexane–ethyl acetate gradient (3 : 1 → 1 : 1). Collect the fractions containing the product (detected by TLC)." ;
    hypmol:stepOrder 6 .

<https://hypmol.net/ProcedureStep/67d987ff-936a-4633-bd59-c17c7356ba08> a hypmol:ProcedureStep ;
    hypmol:observation "Clear, colorless solution." ;
    hypmol:procedureDate "2025-02-14"^^xsd:date ;
    hypmol:stepDescription "Dissolve 2.0 g (0.006 mol) of bis(3,5‑difluoro‑4‑methylphenyl) oxazolidin‑2‑one in 20 mL dry THF inside a reflux vessel under nitrogen." ;
    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/683f767d-b5bc-4ec7-896f-fb214d4a34a1> a hypmol:ProcedureStep ;
    hypmol:observation "Clear, yellow solution." ;
    hypmol:procedureDate "2025-06-01"^^xsd:date ;
