<https://hypmol.net/ProcedureStep/6894ed08-a80b-4805-842c-517eee7c8e69> a hypmol:ProcedureStep ;
    rdfs:label "Placed 5 mmol (2.03 g) of 4‑[(2r)-2,4-dimethyl-5-oxo-3-pyrrolidinyl]-2-methoxy-5,6,7,8-tetrahydroquinoline and 6 mmol (0.82 g) of 4-(2-hydroxyethyl)morpholine in a 100 mL flask with 30 mL of dichlorodifluoroethane (1,1,2-trifluoro)." ;
    hypmol:observation "Mixture became a homogeneous pale amber solution." ;
    hypmol:procedureDate "2025-12-02"^^xsd:date ;
