    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/56a63680-01be-43eb-bd04-9fca376b29fc> a hypmol:ProcedureStep ;
    hypmol:observation "transparent solution with slight turbidity" ;
