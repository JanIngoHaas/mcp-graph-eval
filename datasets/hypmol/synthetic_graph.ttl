<https://hypmol.net/ProcedureStep/c70df86e-a05c-49a3-b1a3-e706f3e02809> a hypmol:ProcedureStep ;
    hypmol:observation "LC‑MS shows peak at 469 m/z rising steadily." ;
    hypmol:procedureDate "2026-01-15"^^xsd:date ;
    hypmol:stepDescription "Seal the tube, evacuate, and backfill with nitrogen 3 times. Heat to 110 °C and stir for 12 h. Monitor the reaction by LC‑MS (m/z = 467 for product)." ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/c77c0dd4-6f3e-469b-b55a-feb9fe2cb253> a hypmol:ProcedureStep ;
    hypmol:observation "The mixture turns clear and slightly yellow." ;
    hypmol:procedureDate "2025-11-01"^^xsd:date ;
