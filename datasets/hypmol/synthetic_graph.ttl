    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/5eeace81-4c52-41f9-9703-1c023298680e> a hypmol:ProcedureStep ;
    hypmol:observation "Yield: 72 % (≈0.78 g)." ;
    hypmol:procedureDate "2025-06-01"^^xsd:date ;
    hypmol:stepDescription "Dry over Na₂SO₄, filter, and evaporate to obtain the product." ;
    hypmol:stepOrder 4 .

<https://hypmol.net/ProcedureStep/5f259e75-6728-41f0-9c62-da8b17727626> a hypmol:ProcedureStep ;
    hypmol:observation "Product shows a white crystalline precipitate in the first column fraction." ;
    hypmol:procedureDate "2026-01-15"^^xsd:date ;
    hypmol:stepDescription "Purify by flash chromatography (silica gel, hexane/EtOAc = 10/1) to afford the desired sulfonyl chloride (yield ≈ 73 %)." ;
    hypmol:stepOrder 5 .

<https://hypmol.net/ProcedureStep/5f619b5c-ba60-4548-93cb-8cc3889ec5b8> a hypmol:ProcedureStep ;
    hypmol:observation "Color change from blue to green." ;
    hypmol:procedureDate "2026-01-16"^^xsd:date ;
    hypmol:stepDescription "The flask is irradiated with a 455 nm LED array at ambient temperature for 12 h under N₂. The reaction mixture becomes pale green." ;
    hypmol:stepOrder 3 .

<https://hypmol.net/ProcedureStep/5f6db474-3f17-4bd4-a6de-419f28523aea> a hypmol:ProcedureStep ;
    hypmol:observation "After 10 h the TLC shows a new single spot corresponding to the adduct." ;
    hypmol:procedureDate "2025-11-02"^^xsd:date ;
    hypmol:stepDescription "Heat the mixture to 120 °C and maintain stirring for 10 h while monitoring the reaction by TLC." ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/5f711c84-fa37-4c00-aef9-3264337b71cc> a hypmol:ProcedureStep ;
    hypmol:observation "yellow suspension forms" ;
    hypmol:procedureDate "2025-11-20"^^xsd:date ;
    hypmol:stepDescription "After complete NaH addition, drop‑wise add 0.050 g (0.20 mmol) of CuI and 0.300 g (0.9 mmol) of CH₃SiCl₃.  Stir at 0 °C for 30 min then allow to warm to room temperature over 2 h." ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/6011c33c-857b-48ee-85b9-77c5fe4559bb> a hypmol:ProcedureStep ;
    hypmol:observation "Solution turns deep reddish‑brown after degassing." ;
    hypmol:procedureDate "2024-07-12"^^xsd:date ;
    hypmol:stepDescription "In a microwave vial, combine 0.2 g (1.2 mmol) of 2‑(methylthio)propanol (A), 0.75 g (5.0 mmol) of n‑(2,3‑di(4‑tert‑butylphenyl)imidazolidin‑4‑yl)ethane‑1,2‑diol (B) and 0.15 g (0.5 mmol) of Pd(OAc)₂ (C) under argon. Add 1 mL of dry DMF. Degas the mixture by 3 freeze–pump–thaw cycles." ;
    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/6030201f-0391-4f7a-9e7e-8210341622a8> a hypmol:ProcedureStep ;
    hypmol:observation "Product present in organic layer; slight orange tint visible." ;
    hypmol:procedureDate "2024-10-11"^^xsd:date ;
    hypmol:stepDescription "Cool to rt, open the flask, add 5 mL of saturated NH₄Cl, extract with EtOAc. Wash with brine, dry over MgSO₄, filter and concentrate." ;
