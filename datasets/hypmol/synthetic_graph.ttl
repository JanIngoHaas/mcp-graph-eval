    hypmol:stepOrder 4 .

<https://hypmol.net/ProcedureStep/6e3aaa1a-907e-42fc-b2d1-f439b5982b16> a hypmol:ProcedureStep ;
    hypmol:observation "Solution slowly clarified; faint greenish hue persisted." ;
    hypmol:procedureDate "2024-08-11"^^xsd:date ;
