    hypmol:stepDescription "Add 2.50 g (2.90 mmol) of bis(3,5‑difluoro‑4‑methylphenyl)oxazolidin‑2‑one to 100 mL of 0.2 M NaOH aqueous solution. Stir for 15 min." ;
    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/63990aad-c562-4b48-bc0a-040bbe2f2545> a hypmol:ProcedureStep ;
    hypmol:observation "A precipitate forms upon concentration." ;
    hypmol:procedureDate "2025-12-01"^^xsd:date ;
    hypmol:stepDescription "Cool, dilute with EtOAc, wash with water, dry over Na₂SO₄, filter, and evaporate." ;
    hypmol:stepOrder 3 .

<https://hypmol.net/ProcedureStep/64b89ccf-475f-4f14-a535-8a8895ad7368> a hypmol:ProcedureStep ;
    hypmol:observation "Mixture remains homogenous." ;
    hypmol:procedureDate "2025-02-18"^^xsd:date ;
    hypmol:stepDescription "In a dry 50 mL round‑bottom flask, add 0.15 g (0.12 mmol) of pentacyclo[6.5.3.0²,⁶.0⁹,¹⁴]tridecane (O) and 0.18 g (0.18 mmol) of 1,3,5‑tris(2,4‑dinitro‑1,3,5‑triazolyl)benzene (P). Dissolve in 10 mL of dry toluene." ;
    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/64c5a034-81d5-41eb-9322-735b4dfabc68> a hypmol:ProcedureStep ;
    hypmol:observation "yield: 0.520 g (95 % theoretical)" ;
    hypmol:procedureDate "2025-09-01"^^xsd:date ;
