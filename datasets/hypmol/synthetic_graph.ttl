    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/6cab9e92-317e-48bb-a849-a20c70aff9eb> a hypmol:ProcedureStep ;
    rdfs:label "Heat to reflux (81 °C) and stir for 6 h; monitor by TLC (hexane/EtOAc 3:1)." ;
