        "radical pair" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
    schema1:name "SpinChem-001: Magnetic‑field dependence of radical‑pair recombination (nitroxide/fluoro‑aryl system)" ;
    schema1:text "The dataset captures ESR line‑shape changes and fluorescence decay constants for a model radical‑pair system under varying magnetic field strengths, revealing a 12 % increase in triplet yield at 80 mT." ;
    schema1:url "https://example.org/datasets/SC‑001"^^xsd:anyURI ;
    hypmol:hasExperiment <https://hypmol.net/Experiment/c3e8c34f-04f8-48ad-922d-7cb10f402975> .

