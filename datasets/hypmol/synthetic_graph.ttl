    hypmol:observation "k_ST increased from 1.2 × 10⁶ s⁻¹ (0 mT) to 2.1 × 10⁶ s⁻¹ (0.5 mT)." ;
    hypmol:procedureDate "2025-10-04"^^xsd:date ;
    hypmol:stepDescription "Fit the decay curves to a biexponential model to extract singlet–triplet interconversion rate (k_ST)." ;
