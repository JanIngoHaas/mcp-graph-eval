<https://hypmol.net/Dataset/5ef94354-2ec8-40b7-8dac-26ac6fe54360> a schema1:Dataset ;
    rdfs:label "SpinChem‑Dataset‑003 – Magnetic Isotope Effect in Cyclobutyl‑Palladium‑Catalyzed C‑C Coupling" ;
