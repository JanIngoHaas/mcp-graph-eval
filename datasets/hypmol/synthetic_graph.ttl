<https://hypmol.net/ProcedureStep/615b206e-c85b-4d64-ab25-b378b5ea35ab> a hypmol:ProcedureStep ;
    hypmol:observation "New spot forms" ;
    hypmol:procedureDate "2025-08-01"^^xsd:date ;
    hypmol:stepDescription "Stir the mixture at 0 °C for 30 min, then slowly raise the temperature to 80 °C over 1 h while maintaining nitrogen flow. At 80 °C, maintain for 6 h. TLC (hexane/EtOAc 9:1) demonstrates disappearance of starting material and appearance of new spot (R_f 0.38)." ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/618f8bda-cc5f-4be9-b7b9-03655262ba96> a hypmol:ProcedureStep ;
    hypmol:observation "Mixture turns opaque due to partial dissolution." ;
