<https://hypmol.net/Dataset/7fac2aaa-add0-48d4-a33d-af731b16acda> a schema1:Dataset ;
    rdfs:label "Pd‑Catalyzed Cross‑Coupling Synthesis of 4-(2‑hydroxyethyl)morpholine" ;
