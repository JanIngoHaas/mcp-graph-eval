<https://hypmol.net/Dataset/5bd7b2f2-b0a5-435c-a06b-1c3c3c67b3ea> a schema1:Dataset ;
    rdfs:label "Magnetically Modulated Synthesis of 1,4‑Bis(trifluoromethyl)benzene from Bis(4‑dimethylamino‑2‑methylphenyl) Sulfone" ;
