    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/c3ecf8bf-bece-436d-ad5b-be406fd5b98b> a hypmol:ProcedureStep ;
    hypmol:observation "Solution turns yellow; no gas evolution." ;
    hypmol:procedureDate "2025-08-15"^^xsd:date ;
    hypmol:stepDescription "Degas the mixture by flushing with N₂ for 5 min, then add 5 mL of dry toluene and 0.5 mL of 1 M LiCl solution." ;
    hypmol:stepOrder 2 .

<https://hypmol.net/ProcedureStep/c4055d8d-dc59-4c17-b439-cf892e1cb6e4> a hypmol:ProcedureStep ;
    hypmol:observation "Color changes to yellow and fumes appear." ;
