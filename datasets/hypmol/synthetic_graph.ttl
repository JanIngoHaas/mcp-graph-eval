    schema1:description "Study of spin‑selective oxidative coupling of 4‑(bromomethyl)-4‑[(e)‑2‑(trifluoromethyl)ethenyl]phenyl acetate to form bis(4‑(trifluoromethyl)phenyl)disulfide under ambient O₂, monitoring transient radical spin states with UV‑Vis and ESR." ;
    schema1:encodingFormat "application/json" ;
    schema1:genre "spin_chemistry" ;
    schema1:identifier "SSC‑DS‑03" ;
    schema1:keywords "UV‑Vis",
        "disulfide formation",
        "magnetic field",
        "radical coupling" ;
    schema1:license "https://creativecommons.org/licenses/by-nc/4.0/"^^xsd:anyURI ;
    schema1:name "SpinSelect_Coupling_Disulfide_2025" ;
    schema1:text "The oxidation proceeds via a transient thiyl radical intermediate whose spin alignment influences product distribution; the experiment compares reactions under zero‑field and a 50 mT static field." ;
    schema1:url "https://data.example.org/ssc-ds-03"^^xsd:anyURI ;
    hypmol:hasExperiment <https://hypmol.net/Experiment/91ae0868-8222-4f34-8a52-14b25aa4a7c2> .

<https://hypmol.net/Dataset/ff2f46df-0a46-49dc-935c-5780c7af9238> a schema1:Dataset ;
    rdfs:label "Spin‑Chemistry Dataset – Spin‑Selective Hydrogenation of 4-(2‑hydroxyethyl)morpholine" ;
    schema1:author <https://hypmol.net/Person/0f019eee-7271-4ee3-b74a-01bef95b9505> ;
    schema1:dateCreated "2025-10-15T11:00:00+00:00"^^xsd:dateTime ;
