<https://hypmol.net/ProcedureStep/69144def-10e0-4210-956e-13450cd906fc> a hypmol:ProcedureStep ;
    rdfs:label "Excite the sample with 420 nm pump pulses (150 fs, 0.5 µJ) and collect transient absorption spectra at delays from 100 fs to 2 µs." ;
