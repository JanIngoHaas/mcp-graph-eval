<https://hypmol.net/Dataset/01c42b19-bb83-49b4-8b67-cbc3be961c74> a schema1:Dataset ;
    rdfs:label "Dataset 9 – Copper‑Catalysed Reductive Alkylation of a Cyclohexanone with (4‑(tert‑butyl)phenyl)‑bis(2,4,6‑trimethoxy‑pyrrole)‑pyridine‑4‑yl‑4‑COCH₃" ;
    schema1:author <https://hypmol.net/Person/a421bf39-49d3-4f34-aa18-859dcd7e6eb3> ;
    schema1:description "An eco‑friendly reductive alkylation where a cyclohexanone is coupled with a bulky pyridyl ketone in the presence of Cu(OAc)₂ and NaBH₄, forming a novel tertiary alcohol.  The reaction proceeds under mild conditions." ;
    schema1:name "Dataset 9 – Copper‑Catalysed Reductive Alkylation of a Cyclohexanone with (4‑(tert‑butyl)phenyl)‑bis(2,4,6‑trimethoxy‑pyrrole)‑pyridine‑4‑yl‑4‑COCH₃" ;
    hypmol:hasExperiment <https://hypmol.net/Experiment/39ebd651-a8de-4adc-9158-fdcd207f292e> .

<https://hypmol.net/Dataset/01e432c6-4d7a-4c7d-a52b-f86bd6ef0d76> a schema1:Dataset ;
    rdfs:label "Dataset 8" ;
    schema1:author <https://hypmol.net/Person/5e8c30fd-a3a4-4dcf-84db-f8fde1503b20> ;
    schema1:description "Formation of a sulfonium salt by alkylation of a dithiopentane ester with a quaternary ammonium chloride." ;
    schema1:name "Dataset 8" ;
    hypmol:hasExperiment <https://hypmol.net/Experiment/e35deb5e-19b9-495c-9bed-08951a07da16> .

<https://hypmol.net/Dataset/020eaa94-8a6c-4955-bd10-26ae6dd2fa6a> a schema1:Dataset ;
    rdfs:label "Reduction of Dichloromethyl Triazine to Aminated Triazine" ;
    schema1:author <https://hypmol.net/Person/1071793d-0e03-47af-ab6c-e2ea2deb12a4> ;
    schema1:description "The experiment reduces 2‑(dichloromethyl)phenyl‑1,3,5‑triazin‑4(1h)-one with NaBH₄, turning the dichloromethyl group into a primary amine. It examines color changes and by‑product formation." ;
    schema1:name "Reduction of Dichloromethyl Triazine to Aminated Triazine" ;
    hypmol:hasExperiment <https://hypmol.net/Experiment/a41911f8-db01-4dd3-88cb-3010cea5f94e> .

<https://hypmol.net/Dataset/043e21d1-bf65-4295-b8f9-c26f52f3784b> a schema1:Dataset ;
    rdfs:label "Dataset 7: Oxidative Cyclization to Form a Triazole Core" ;
    schema1:author <https://hypmol.net/Person/ec7ec00a-d8af-46a6-92c3-6a8dda7792ac> ;
    schema1:description "Examining the oxidative cyclization of a 2‑(bis(1,2,4‑triazolyl)phosphine) ligand with a di-iodinated aromatic to generate a fused triazine triazole scaffold." ;
    schema1:name "Dataset 7: Oxidative Cyclization to Form a Triazole Core" ;
    hypmol:hasExperiment <https://hypmol.net/Experiment/91f4e3e6-0190-413d-b4c5-84bc638af579> .

<https://hypmol.net/Dataset/05b97fd0-d473-4e54-85ec-1265a05182d8> a schema1:Dataset ;
    rdfs:label "Photochemical Synthesis of a Sulfonyl‑Activated Carbamate via 4‑(Trimethyl‑silyl)pyrrolidin‑2‑yl)pentyl‑sulfonyl chloride" ;
    schema1:author <https://hypmol.net/Person/3e0a1a11-152a-4b2a-ae14-d1c2ef72b07d> ;
    schema1:description "Exploring a visible‑light driven coupling of a silyl‑protected pyrrolidine with a sulfonyl chloride, examining the efficiency of the photoinduced radical opening of the sulfonyl chloride." ;
    schema1:name "Photochemical Synthesis of a Sulfonyl‑Activated Carbamate via 4‑(Trimethyl‑silyl)pyrrolidin‑2‑yl)pentyl‑sulfonyl chloride" ;
    hypmol:hasExperiment <https://hypmol.net/Experiment/577316ee-b06f-4059-9845-764375b962a5> .

<https://hypmol.net/Dataset/065ac964-31a3-47bf-b667-eebeeb326c58> a schema1:Dataset ;
    rdfs:label "Cyclization to a Tetrahydro‑Oxazinone" ;
    schema1:author <https://hypmol.net/Person/3532836c-ea92-413d-a311-302b35e20832> ;
    schema1:description "Intramolecular cyclization of (3,5‑dichloro‑2‑(tert‑butyl)phenyl)diazenyl‑benzo‑1,4‑dioxan‑2‑one in the presence of a Lewis acid to yield a tetrahydro‑oxazinone scaffold." ;
    schema1:name "Cyclization to a Tetrahydro‑Oxazinone" ;
    hypmol:hasExperiment <https://hypmol.net/Experiment/c5ce3dc4-19fd-4ac7-8684-57c75ed75128> .

<https://hypmol.net/Dataset/06c801a4-b39c-4b09-adf9-ddeda5a67bf6> a schema1:Dataset ;
    rdfs:label "Dataset 8 – Synthesis of 5‑(3,5‑Dichlorophenyl)bis(1,3,5,7‑tetramethyl-1h‑imidazol‑2‑yl)thioindane from (4‑(tert‑butyl)phenyl)bis(2,4,6‑trimethoxy‑1h‑imidazol‑2‑yl)‑pyrimidine‑3‑yl ketone" ;
    schema1:author <https://hypmol.net/Person/3183fadd-7c89-4e41-bb23-6cba6e4d3ba7> ;
    schema1:description "An intramolecular thioetherification is achieved by reacting a bis‑imidazolyl ketone with a thioindane precursor under Lewis acid catalysis. The product is isolated as a crystalline solid and its optical rotation measured." ;
