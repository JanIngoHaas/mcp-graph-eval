<https://hypmol.net/ProcedureStep/dd8e010e-6d99-424c-a52e-686bc43467ee> a hypmol:ProcedureStep ;
    rdfs:label "Repeat the experiment under external magnetic fields of 0, 20, and 80 mT using the Helmholtz coil, keeping all other conditions constant." ;
