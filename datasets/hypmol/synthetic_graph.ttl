    hypmol:stepDescription "Perform the same set of measurements in acetonitrile (polar solvent) using identical concentrations." ;
    hypmol:stepOrder 4 .

<https://hypmol.net/ProcedureStep/69807056-d68f-46c1-989e-ebae71c4b5b4> a hypmol:ProcedureStep ;
    rdfs:label "Transfer the solution to a 1 mm quartz cuvette, mount in the magnetic shield, and equilibrate at 298 K for 10 min." ;
