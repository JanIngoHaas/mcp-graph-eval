<https://hypmol.net/Dataset/fce32ee7-8d7f-4012-9e2e-e9a4aa8cbfe1> a schema1:Dataset ;
    rdfs:label "One‑Pot Palladium‑Catalyzed Synthesis of bis(2,3,4,5‑tetrafluorophenyl) Ether" ;
