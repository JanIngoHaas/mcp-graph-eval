    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/6b287ed8-bda1-4424-9c9b-a74f9102f616> a hypmol:ProcedureStep ;
    hypmol:observation "Pale yellow crystals isolated." ;
    hypmol:procedureDate "2025-12-23"^^xsd:date ;
