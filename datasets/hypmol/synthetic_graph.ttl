<https://hypmol.net/ProcedureStep/01526c4a-786d-47c6-b5b8-c4b6d1a54575> a hypmol:ProcedureStep ;
    rdfs:label "Repeat the pulse sequence at field increments of 30 mT up to 270 mT, collecting three replicates per field." ;
