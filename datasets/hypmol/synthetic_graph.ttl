<https://hypmol.net/ProcedureStep/c22fbe1e-0c14-46ee-bfd4-0fdaf60f7a82> a hypmol:ProcedureStep ;
    hypmol:observation "Clear, slightly opalescent liquid." ;
    hypmol:procedureDate "2025-06-01"^^xsd:date ;
