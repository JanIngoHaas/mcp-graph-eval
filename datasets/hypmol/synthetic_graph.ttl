    hypmol:hasExperiment <https://hypmol.net/Experiment/7d3c9244-729b-4613-951e-bf64861041ea> .

<https://hypmol.net/Dataset/7fcb488c-721e-46c7-afc6-84c323219abf> a schema1:Dataset ;
    rdfs:label "Transient‑Absorption Study of a Fluorinated Radical Pair" ;
    schema1:author <https://hypmol.net/Person/7daf282f-2b7d-4db5-96e0-fdb5f6afa032> ;
    schema1:dateCreated "2025-10-10T10:00:00+00:00"^^xsd:dateTime ;
    schema1:dateModified "2025-10-28T16:40:00+00:00"^^xsd:dateTime ;
    schema1:datePublished "2025-11-01T08:15:00+00:00"^^xsd:dateTime ;
    schema1:description "A laser flash‑photolysis experiment investigates the formation and decay of a radical pair generated from trichloromethyl‑4,5‑dihydrooxazole and tetrahydroisoquinoline‑3‑carboxylic acid (s,n)-dioxide in the presence of n‑[(3,5‑dimethylphenyl)sulfonyl]oxalamide as a hydrogen‑atom donor. The focus is on the magnetic‑field dependence of the recombination kinetics." ;
    schema1:encodingFormat "application/json" ;
    schema1:genre "spin‑chemistry" ;
    schema1:identifier "SC‑TA‑R001" ;
    schema1:keywords "fluoro‑oxazole",
        "laser flash photolysis",
        "magnetic‑field",
        "radical‑pair" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/"^^xsd:anyURI ;
    schema1:name "Transient‑Absorption Study of a Fluorinated Radical Pair" ;
    schema1:text "The transient absorption at 460 nm shows a biexponential decay; the slower component lengthens by ~30 % when a 0.3 T field is applied, indicating field‑controlled spin‑selective recombination." ;
    schema1:url "https://example.org/datasets/SC-TA-R001"^^xsd:anyURI ;
    hypmol:hasExperiment <https://hypmol.net/Experiment/18dd778c-2e27-4f99-8048-cb870aed613a> .

