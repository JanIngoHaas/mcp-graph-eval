    hypmol:stepOrder 1 .

<https://hypmol.net/ProcedureStep/684fa7b1-a07a-41a5-b164-a4c99dc1158d> a hypmol:ProcedureStep ;
    hypmol:observation "crude residue appears yellow" ;
    hypmol:procedureDate "2025-09-18"^^xsd:date ;
