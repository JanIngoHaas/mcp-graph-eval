    hypmol:observation "An exothermic reaction; light brown precipitate forms." ;
    hypmol:procedureDate "2025-09-10"^^xsd:date ;
    hypmol:stepDescription "Cool the reaction to r.t., pour into 100 mL of cold diethyl ether, and add 10 mL of saturated NaHCO₃ solution to quench." ;
