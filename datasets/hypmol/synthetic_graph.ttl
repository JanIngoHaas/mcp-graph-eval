<https://hypmol.net/ProcedureStep/6e3097f7-7cf5-4070-ac73-24ece398856c> a hypmol:ProcedureStep ;
    hypmol:observation "The organic layer turns amber." ;
    hypmol:procedureDate "2025-11-01"^^xsd:date ;
