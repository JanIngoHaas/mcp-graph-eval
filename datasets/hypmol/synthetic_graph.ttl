<https://hypmol.net/ProcedureStep/6ac66b46-10bf-4e4c-b46d-c947baddb566> a hypmol:ProcedureStep ;
    rdfs:label "Analyse the kinetic decay of the radical‑pair signal using exponential fitting to obtain rate constants at each field strength." ;
    hypmol:observation "Rate constants: 0 mT = 1.2 ×10⁵ s⁻¹, 80 mT = 5.8 ×10⁴ s⁻¹." ;
    hypmol:procedureDate "2025-11-12"^^xsd:date ;
    hypmol:stepDescription "Analyse the kinetic decay of the radical‑pair signal using exponential fitting to obtain rate constants at each field strength." ;
