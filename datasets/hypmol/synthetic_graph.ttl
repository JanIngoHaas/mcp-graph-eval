    schema1:license "https://creativecommons.org/licenses/by-nc/4.0/"^^xsd:anyURI ;
    schema1:name "Spin‑Chemistry Dataset – Spin‑Selective Hydrogenation of 4-(2‑hydroxyethyl)morpholine" ;
    schema1:text "Catalytic turnover was increased by ~30 % when a 50 mT static field was applied, correlating with enhanced spin alignment on the Pd surface." ;
