<https://hypmol.net/ProcedureStep/d7d81c38-afa6-4ab7-b69b-28c76d084a80> a hypmol:ProcedureStep ;
    rdfs:label "Repeat excitation (10 shots) and average the ESR signal to improve signal‑to‑noise; compare with a control sample lacking the catalyst." ;
    hypmol:observation "Catalyst‑free sample shows negligible ESR signal, confirming catalyst‑mediated triplet formation." ;
    hypmol:procedureDate "2025-12-04"^^xsd:date ;
    hypmol:stepDescription "Repeat excitation (10 shots) and average the ESR signal to improve signal‑to‑noise; compare with a control sample lacking the catalyst." ;
    hypmol:stepOrder 5 .

