# SPARQL Endpoint Configuration
SPARQL_ENDPOINT=http://localhost:7001/sparql
SPARQL_QUERY_DELAY=0.01

# MCP Server Configuration
MCP_SERVER_URL=http://localhost:3000/mcp

# LLM Configuration (for local Ollama)
# Note: Models to evaluate are configured in src/eval/runner.py (EVAL_MODELS list)
# Temperature is hardcoded to 0 for deterministic evaluation
EVAL_LLM_BASE_URL=http://localhost:11434/v1
EVAL_LLM_API_KEY=ollama

# Evaluation Runner Settings
EVAL_CONCURRENCY=1